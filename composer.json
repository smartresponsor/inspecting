{
  "name": "inspecting/engine",
  "type": "symfony-bundle",
  "description": "Standalone PHP quality-inspection engine for SOLID, code-smell and maintainability analysis.",
  "license": "proprietary",
  "require": {
    "php": "^8.4",
    "nikic/php-parser": "^5.9",
    "symfony/console": "^8.1",
    "symfony/process": "^8.1",
    "collectioning/collection": "dev-master",
    "cruding/crud": "dev-master",
    "easycorp/easyadmin-bundle": "^5.5",
    "failing/failure": "dev-master",
    "interfacing/interface": "dev-master",
    "objecting/object": "dev-master",
    "tabling/table": "dev-master",
    "viewing/view": "dev-master",
    "symfony/config": "^8.1",
    "symfony/dependency-injection": "^8.1",
    "symfony/framework-bundle": "^8.1",
    "symfony/http-kernel": "^8.1",
    "symfony/yaml": "^8.1"
  },
  "require-dev": {
    "friendsofphp/php-cs-fixer": "^3.95",
    "gating/gate": "dev-master",
    "phpstan/phpstan": "^2.2",
    "phpunit/phpunit": "^13.3",
    "rector/rector": "^2.4",
    "symfony/browser-kit": "^8.1",
    "symfony/css-selector": "^8.1",
    "symfony/panther": "^2.4"
  },
  "autoload": {
    "psr-4": {
      "App\\Inspecting\\": "src/"
    }
  },
  "bin": [
    "bin/inspecting"
  ],
  "scripts": {
    "cs:check": "php-cs-fixer fix --dry-run --diff --verbose",
    "cs:fix": "php-cs-fixer fix --verbose",
    "phpstan": "phpstan analyse --configuration=phpstan.neon",
    "rector:check": "rector process --dry-run --config rector.php",
    "rector:fix": "rector process --config rector.php",
    "inspect:self": "@php bin/inspecting inspect .",
    "test": "phpunit",
    "test:coverage": [
      "@php -r \"if (!is_dir('var/coverage')) { mkdir('var/coverage', 0777, true); }\"",
      "@php -d xdebug.mode=coverage vendor/bin/phpunit --path-coverage --coverage-text=var/coverage/summary.txt --coverage-clover=var/coverage/clover.xml"
    ],
    "gate": "@php vendor/bin/gating check --target=. --rule-set=vendor/gating/gate/.gating/profile/rule-set/administering.yaml",
    "quality": [
      "@cs:check",
      "@phpstan",
      "@test",
      "@gate"
    ],
    "test:behavioral-coverage": "@php tool/behavioral-coverage.php",
    "lint:container": "@php bin/console lint:container",
    "validate:prod": "composer validate --strict --no-check-all composer.prod.json"
  },
  "minimum-stability": "dev",
  "prefer-stable": true,
  "repositories": [
    {
      "type": "path",
      "url": "../Gating",
      "options": {
        "symlink": true,
        "versions": {
          "gating/gate": "dev-master"
        }
      }
    },
    {
      "type": "path",
      "url": "../Cruding",
      "options": {
        "symlink": true,
        "versions": {
          "cruding/crud": "dev-master"
        }
      }
    },
    {
      "type": "path",
      "url": "../Collectioning",
      "options": {
        "symlink": true,
        "versions": {
          "collectioning/collection": "dev-master"
        }
      }
    },
    {
      "type": "path",
      "url": "../Tabling",
      "options": {
        "symlink": true,
        "versions": {
          "tabling/table": "dev-master"
        }
      }
    },
    {
      "type": "path",
      "url": "../Viewing",
      "options": {
        "symlink": true,
        "versions": {
          "viewing/view": "dev-master"
        }
      }
    },
    {
      "type": "path",
      "url": "../Interfacing",
      "options": {
        "symlink": true,
        "versions": {
          "interfacing/interface": "dev-master"
        }
      }
    },
    {
      "type": "path",
      "url": "../Objecting",
      "options": {
        "symlink": true,
        "versions": {
          "objecting/object": "dev-master"
        }
      }
    },
    {
      "type": "path",
      "url": "../Failing",
      "options": {
        "symlink": true,
        "versions": {
          "failing/failure": "dev-master"
        }
      }
    }
  ],
  "extra": {
    "symfony": {
      "bundle": "App\\Inspecting\\InspectingBundle",
      "require": "8.1.*"
    }
  }
}
