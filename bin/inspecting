#!/usr/bin/env php
<?php

declare(strict_types=1);

use App\Analyzer\PhpStanAnalyzer;
use App\Analyzer\PhpStructureAnalyzer;
use App\Analyzer\RectorAnalyzer;
use App\Analyzer\SemgrepAnalyzer;
use App\Command\InspectCommand;
use App\Inspection\Inspector;
use Symfony\Component\Console\Application;

$autoload = dirname(__DIR__) . '/vendor/autoload.php';

if (!is_file($autoload)) {
    fwrite(STDERR, "Inspecting dependencies are not installed. Run composer install.\n");
    exit(2);
}

require $autoload;

$application = new Application('Inspecting', '0.1.0-dev');
$application->addCommand(new InspectCommand(new Inspector([
    new PhpStanAnalyzer(),
    new PhpStructureAnalyzer(),
    new RectorAnalyzer(),
    new SemgrepAnalyzer(),
])));
$application->run();
