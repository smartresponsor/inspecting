#!/usr/bin/env php
<?php

declare(strict_types=1);

use App\Inspecting\Analyzer\EnginePhpStanAnalyzer;
use App\Inspecting\Analyzer\EnginePhpStructureAnalyzer;
use App\Inspecting\Analyzer\EngineRectorAnalyzer;
use App\Inspecting\Analyzer\EngineSemgrepAnalyzer;
use App\Inspecting\Command\EngineInspectCommand;
use App\Inspecting\Command\EngineReportCommand;
use App\Inspecting\Inspector\EngineInspector;
use Symfony\Component\Console\Application;

$autoload = dirname(__DIR__) . '/vendor/autoload.php';

if (!is_file($autoload)) {
    fwrite(STDERR, "Inspecting dependencies are not installed. Run composer install.\n");
    exit(2);
}

require $autoload;

$application = new Application('Inspecting', '0.1.0-dev');
$application->addCommand(new EngineInspectCommand(new EngineInspector([
    new EnginePhpStanAnalyzer(),
    new EnginePhpStructureAnalyzer(),
    new EngineRectorAnalyzer(),
    new EngineSemgrepAnalyzer(),
])));
$application->addCommand(new EngineReportCommand());
$application->run();
