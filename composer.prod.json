{
  "name": "inspecting/engine",
  "type": "library",
  "description": "Standalone PHP quality-inspection engine for SOLID, code-smell and maintainability analysis.",
  "license": "proprietary",
  "require": {
    "php": "^8.4",
    "nikic/php-parser": "^5.9",
    "symfony/console": "^8.1",
    "symfony/process": "^8.1"
  },
  "require-dev": {
    "friendsofphp/php-cs-fixer": "^3.95",
    "gating/gate": "dev-master",
    "phpstan/phpstan": "^2.2",
    "phpunit/phpunit": "^13.3",
    "rector/rector": "^2.4"
  },
  "autoload": {
    "psr-4": {
      "App\\": "src/"
    }
  },
  "bin": [
    "bin/inspecting"
  ],
  "scripts": {
    "cs:check": "php-cs-fixer fix --dry-run --diff --verbose",
    "cs:fix": "php-cs-fixer fix --verbose",
    "phpstan": "phpstan analyse --configuration=phpstan.neon",
    "rector:check": "rector process --dry-run --config rector.php",
    "rector:fix": "rector process --config rector.php",
    "inspect:self": "@php bin/inspecting inspect .",
    "test": "phpunit",
    "test:coverage": [
      "@php -r \"if (!is_dir('var/coverage')) { mkdir('var/coverage', 0777, true); }\"",
      "@php -d xdebug.mode=coverage vendor/bin/phpunit --path-coverage --coverage-text=var/coverage/summary.txt"
    ],
    "gate": "@php vendor/bin/gating check --target=.",
    "quality": ["@cs:check", "@phpstan", "@test", "@gate"]
  },
  "minimum-stability": "dev",
  "prefer-stable": true,
  "repositories": [
    {
      "type": "vcs",
      "url": "https://github.com/smartresponsor/gating.git",
      "no-api": true
    }
  ]
}
